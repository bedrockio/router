{
  "include": [
    "./src/index.js"
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "jsx": "react-jsx",
    "target": "esnext",
    "module": "nodenext",
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "skipLibCheck": false,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
  },
}